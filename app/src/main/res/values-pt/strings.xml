    <string name="help_item_display_modes"><b>Modos de Exibição:</b> Alterna entre visualizações em grade e página dupla. Suporta alternar entre as direções de leitura da direita para a esquerda (RTL) e da esquerda para a direita (LTR).</string>
    <string name="help_item_device_optimization"><b>Suporte a Dispositivos:</b> Totalmente otimizado para smartphones, tablets, dispositivos dobráveis e desktop (ChromeOS, etc. com atalhos de teclado e clique direito).</string>
    <string name="help_item_button_reference"><b>Referência dos Botões da Barra de Ferramentas:</b><br />• <b>Abrir / Salvar / Adicionar:</b> Carregar PDFs, salvar todas as páginas, mesclar PDFs.<br />• <b>Seleção:</b> Selecionar tudo, limpar ou inverter seleção.<br />• <b>Edição de Páginas:</b> Rotacionar, mover (cima/baixo), dividir, inserir página em branco, excluir ou exportar selecionadas.<br />• <b>Visualização &amp; Configurações:</b> Alternar exibição (grade/dupla), direção RTL/LTR, capa, propriedades e segurança por senha.</string>
<string name="action_rotate_left">Rotate Left</string><string name="action_settings">Settings</string><string name="settings_options">Options</string><string name="settings_help">Help</string><string name="report_github">Report Issue on GitHub</string><string name="options_title">Thumbnail Image Size</string><string name="options_size_s">Small (S)</string><string name="options_size_m">Medium (M)</string><string name="options_size_l">Large (L)</string><string name="options_desc">Select thumbnail image size (S/M/L).</string><string name="help_title">App Guide &amp; Help</string><string name="help_overview_title">1. Overview</string><string name="help_overview_text">Mihiraki PDF Utility supports 14 languages, page reordering, spread view (RTL/LTR), deleting, rotating, splitting, margin cropping, metadata/password settings, diagnostics, and local audit logs.</string><string name="help_open_title">2. Opening &amp; Saving PDFs</string><string name="help_open_text">Tap the Open icon (or Ctrl+O) to load a PDF. Use Save (Ctrl+S) to save all pages, or Export Selected (Ctrl+E) to save selected pages.</string><string name="help_page_ops_title">3. Page Operations</string><string name="help_page_ops_text">Tap pages to select them. When pages are selected, the top toolbar buttons automatically switch from general controls (Save, Add, Settings) to page editing actions (Rotate, Move, Split, Insert Blank, Delete, Export Selected).</string><string name="help_display_title">4. Display Modes &amp; Devices</string><string name="help_display_text">Toggle between Grid and Spread views. Use Toggle RTL to switch between Right-to-Left (RTL) and Left-to-Right (LTR) reading directions (manga/books). Optimized for smartphones, tablets, and ChromeOS.</string><string name="help_settings_title">5. Settings, Diagnostics &amp; Support</string><string name="help_settings_text">From the settings menu (gear icon or support heart button), you can configure and view properties, password, options, version, help, diagnostics, and support items.</string><string name="help_item_overview" /><string name="help_item_open_save" /><string name="help_item_page_ops" /><string name="help_item_devices" /><string name="help_item_properties" /><string name="help_item_security" /><string name="help_item_options" /><string name="help_item_support" /><string name="help_item_diagnostics" /><string name="help_item_audit_logs" /><string name="help_item_report_issues" /><string name="help_purchased_items">Purchased Support Badges</string><string name="help_no_purchased_items">No support items purchased yet.</string><string name="prop_pdf_version_label">PDF Version</string><string name="version_license_title">License &amp; Open Source</string><string name="version_license_text">Distributed under the Apache License 2.0.\n\nThird-Party Software:\n• Apache PDFBox-Android (Copyright The Apache Software Foundation, Apache License 2.0)\n• AndroidX &amp; Jetpack Compose (Google LLC, Apache License 2.0)</string><string name="free_use_message">This app is completely free to use. All features, such as editing and saving PDFs, are available without restriction regardless of purchase.</string><string name="purchase_badge_shown">Support badge displayed on the version screen.</string><string name="action_property">Property</string><string name="action_right_binding">Right Binding</string><string name="action_right_binding_cover">Right Binding &amp; Cover</string><string name="run_diagnostics">Run Diagnostic Tests</string><string name="diagnostics_title">Diagnostic Test Results</string><string name="diagnostics_privacy">Note: Test results are displayed locally only. There is no feature to transmit test results externally.</string><string name="share_results">Share Results</string><string name="bulk_copy">Bulk Copy (Diagnostics &amp; Logs)</string><string name="bulk_copy_success">Diagnostic report and logs copied to clipboard.</string><string name="report_issue">Report Issue</string><string name="report_include_title">Include in your report</string><string name="report_step_1">1. Brief summary of the issue</string><string name="report_step_2">2. Steps to reproduce</string><string name="report_step_3">3. Expected and actual behavior</string><string name="report_step_4">4. Frequency of occurrence</string><string name="report_step_5">5. App version, OS version, device, and display settings</string><string name="report_step_6">6. Screenshots, app logs, or diagnostic results</string><string name="copy_all_diagnostics">Copy All Diagnostics &amp; Logs</string><string name="privacy_protection">Protect your privacy</string><string name="privacy_note_1">• Do not include personal info such as actual PDF files, document content, file names, or names.</string><string name="privacy_note_2">• Please review screenshots and diagnostic info before sharing. Data is not sent automatically.</string><string name="results_copied">Results copied to clipboard</string><string name="device_info_format">Device: %1$s %2$s (Android %3$s)</string><string name="test_timestamp_format">Timestamp: %1$s</string><string name="view_app_logs">View App Logs</string><string name="logs_dialog_title">App Audit Logs</string><string name="logs_privacy">Note: Logs are stored locally on device only. There is no feature to transmit logs externally.</string><string name="copy_logs">Copy Logs to Clipboard</string><string name="logs_copied">Logs copied to clipboard</string><string name="share_logs">Share Logs</string><string name="promo_code_help_title">How to Redeem Promo Code</string><string name="promo_code_help_message">To redeem a promotion code, open the Support screen, tap the purchase button, and select "Redeem" from the Google Play payment methods menu.</string><string name="go_to_support">Go to Support</string><string name="sample_pdf">Sample PDF</string><string name="sample_pdfs" translatable="false">Sample PDFs</string><string name="language_filter" translatable="false">Language Filter</string><string name="all_languages" translatable="false">All</string><string name="sample_pdf_download" translatable="false">Download</string><string name="sample_pdf_downloading" translatable="false">Downloading...</string><string name="sample_pdf_downloading_progress" translatable="false">Downloading... %d%%</string><string name="sample_pdf_open" translatable="false">Open</string><string name="sample_pdf_delete" translatable="false">Delete</string><string name="cellular_data_warning" translatable="false">Cellular Data Warning</string><string name="cellular_data_message" translatable="false">You are currently on a cellular network. Downloading \"%1$s\" (%2$s) may consume a significant amount of mobile data. Do you want to proceed?</string><string name="error_prefix" translatable="false">Error: %s</string><string name="cc_by_dialog_title">Sample PDF License (CC BY 4.0)</string><string name="cc_by_dialog_text">Before modifying or saving the sample PDF, please review the Creative Commons Attribution 4.0 International (CC BY 4.0) terms:\n\n• Author: Komairo Hiyori\n• License: CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/)\n• When reusing, modifying, or saving, please display the title, author name, license link, and indicate any modifications made.\n\nNote: You have full freedom to modify and save the sample PDF without restriction.</string><string name="cc_by_dialog_confirm">Agree &amp; Proceed</string><string name="options_button_display_title">Button Display Type</string><string name="button_display_icon_and_text">Icon + Text (Default)</string><string name="button_display_icon_only">Icon Only</string><string name="button_display_text_only">Text Only</string><string name="folder_images_title">Images in Folder</string><string name="sort_options_label">Sort By</string><string name="sort_by_name">Name</string><string name="sort_by_creation">Creation Date</string><string name="sort_by_modified">Last Modified Date</string><string name="sort_ascending">Ascending</string><string name="sort_descending">Descending</string><string name="image_count_label">Images count</string><string name="btn_create_pdf_from_images">Create PDF</string><string name="menu_open_folder">Open Folder</string><string name="commemorative_badge_title">Release Commemorative Koyomi Badge</string><string name="commemorative_badge_desc">Claim the official \"Tameshibu\" Koyomi badge for free to celebrate the commercial release!</string><string name="claim_free_badge">Claim Free Badge</string><string name="badge_claimed_success">Koyomi badge claimed successfully!</string><string name="action_owned">Owned</string><string name="diagnostics_endurance_title">Long-Running Stress Test</string><string name="diagnostics_endurance_desc">Select test duration and run continuous stress tests including 14-manga merge, 1100-page 9x append, editing stress, rotation, and foldable simulation.</string><string name="endurance_progress_text">Progress: Elapsed %1$d min / Target %2$d min</string><string name="endurance_iteration_text">Iteration: #%1$d</string><string name="endurance_course_text">Current Course: %1$s</string><string name="endurance_memory_text">Memory Usage: %1$d MB</string><string name="endurance_pattern_select">Test Course &amp; Pattern Selection:</string><string name="endurance_stop_test">Stop Test</string><string name="endurance_start_test">Start Test (%1$d min)</string><string name="download_all_test_files">Download All Test PDFs &amp; Samples</string><string name="cancel_download">Cancel Download</string><string name="endurance_running_banner">⚡ [Endurance Test Running] Elapsed: %1$d min / Target: %2$d min (#%3$d)</string><string name="endurance_stop_button">Stop</string><string name="processing_pdf_message">Processing &amp; merging PDF files…\nPlease wait.</string><string name="course_option_all">All Courses (Patterns 1–10)</string><string name="course_option_pattern_1">Pattern 1 (Multi-File Merge)</string><string name="course_option_pattern_2">Pattern 2 (1100p Append 9x)</string><string name="course_option_pattern_3">Pattern 3 (Merge + Editing Stress)</string><string name="course_option_pattern_4">Pattern 4 (Append + Editing Stress)</string><string name="course_option_pattern_5">Pattern 5 (Merge + Screen Rotation)</string><string name="course_option_pattern_6">Pattern 6 (Append + Screen Rotation)</string><string name="course_option_pattern_7">Pattern 7 (Merge + Foldable Simulation)</string><string name="course_option_pattern_8">Pattern 8 (Append + Foldable Simulation)</string><string name="course_option_pattern_9">Pattern 9 (Full Combination A)</string><string name="course_option_pattern_10">Pattern 10 (Full Combination B)</string><string name="help_show_tutorial">Show Tutorial Guide</string><string name="tutorial_skip">Skip</string><string name="tutorial_next">Next</string><string name="tutorial_finish">Get Started</string><string name="tutorial_try_sample">Try Sample PDF</string><string name="tutorial_title_1">Welcome to Mihiraki PDF Utility</string><string name="tutorial_desc_1">Optimized for reading and organizing scanned books and manga with double-page spread views and RTL/LTR support across 14 languages.</string><string name="tutorial_title_2">Open &amp; Sample PDFs</string><string name="tutorial_desc_2">Tap Open (Ctrl+O) to load any PDF file, or try out the built-in sample PDF catalog right away.</string><string name="tutorial_title_3">Page Operations &amp; Editing</string><string name="tutorial_desc_3">Select pages with a tap to reorder, rotate, split spreads, insert blank pages, or delete unwanted pages easily.</string><string name="tutorial_title_4">Display Modes &amp; RTL Reading</string><string name="tutorial_desc_4">Switch between grid view and spread view instantly. Toggle right-to-left (RTL) reading mode for manga and traditional books.</string><string name="tutorial_title_5">Save &amp; Export</string><string name="tutorial_desc_5">Save all pages as a new PDF (Ctrl+S) or export selected pages only. You are all set to start!</string>    <string name="help_category_getting_started">Getting Started</string>
