    <string name="help_title">App Guide &amp; Help</string>
    <string name="help_overview_title">1. Overview</string>
    <string name="help_overview_text">Mihiraki PDF Utility supports 13 languages, page reordering, spread view (RTL/LTR), deleting, rotating, splitting, margin cropping, metadata/password settings, diagnostics, and local audit logs.</string>
    <string name="help_open_title">2. Opening &amp; Saving PDFs</string>
    <string name="help_open_text">Tap the Open icon (or Ctrl+O) to load a PDF. Use Save (Ctrl+S) to save all pages, or Export Selected (Ctrl+E) to save selected pages.</string>
    <string name="help_page_ops_title">3. Page Operations</string>
    <string name="help_page_ops_text">Tap pages to select them. Selected pages can be rotated, deleted, moved, inserted with blank pages, split (vertical/horizontal), or cropped (margin cropping).</string>
    <string name="help_display_title">4. Display Modes &amp; Devices</string>
    <string name="help_display_text">Toggle between Grid and Spread views. Use Toggle RTL for right-to-left reading mode (manga/books). Optimized for smartphones, tablets, and ChromeOS.</string>
    <string name="help_settings_title">5. Settings, Diagnostics &amp; Support</string>
    <string name="help_settings_text">From the settings menu (gear icon or support heart button), you can configure and view the following items:\n\n    • Properties: Configure document title, author, subject, keywords, PDF version, and page layout.\n    • Password: Set or clear the encryption password for saving and exporting.\n    • Options: Select thumbnail image size (Small/Medium/Large).\n    • Version: View app version, build number, licenses, purchased badges, and redeem promo codes.\n    • Help: Display this app guide.\n    • Diagnostics: Run system diagnostic tests, review privacy-protected local operation and runtime error audit logs (automatically retained for 24 hours, strictly excluding personal data), share reports, and report issues on GitHub.\n    • Support: Purchase one-time support items (Bronze, Silver, Gold) or redeem Google Play promotion codes to support app development.</string>
    <string name="help_purchased_items">Purchased Support Badges</string>
    <string name="help_no_purchased_items">No support items purchased yet.</string>

