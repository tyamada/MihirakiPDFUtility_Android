    <string name="help_title">App Guide &amp; Help</string>
    <string name="help_overview_title">1. Overview</string>
    <string name="help_overview_text">Mihiraki PDF Utility allows you to reorder PDF pages, view spreads (RTL/LTR), delete, rotate, split, crop pages, and set metadata/passwords.</string>
    <string name="help_open_title">2. Opening &amp; Saving PDFs</string>
    <string name="help_open_text">Tap the Open icon (or Ctrl+O) to load a PDF. Use Save (Ctrl+S) to save all pages, or Export Selected (Ctrl+E) to save selected pages.</string>
    <string name="help_page_ops_title">3. Page Operations</string>
    <string name="help_page_ops_text">Tap pages to select them. Selected pages can be rotated, deleted, moved, inserted with blank pages, split, or cropped.</string>
    <string name="help_display_title">4. Display Modes</string>
    <string name="help_display_text">Toggle between Grid and Spread views. Use Toggle RTL for right-to-left reading mode (manga/books).</string>
    <string name="help_settings_title">5. Properties &amp; Security</string>
    <string name="help_settings_text">Configure document title, author, layout settings, and set encryption passwords in Settings.</string>

